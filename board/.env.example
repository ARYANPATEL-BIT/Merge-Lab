# Copy to .env.local and fill in to run against a deployed registry.
# Leave VITE_API_URL unset (or delete this file) to run in demo mode, which
# renders from fixtures/declarations.sample.json with no backend.

# Base URL of the Merge Lab HTTP API (the SAM stack's ApiUrl output).
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com

# Static workspace bearer token (the MergelabToken deploy parameter).
VITE_API_TOKEN=your-workspace-token

# Repo whose board to show. Defaults to acme/app (the demo fixture's repo).
VITE_REPO=acme/app
