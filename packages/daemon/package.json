{
  "name": "@handshake/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "handshake": "dist/cli.cjs"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/cli.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@handshake/extractor": "workspace:*",
    "@handshake/hooks": "workspace:*",
    "@handshake/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}
